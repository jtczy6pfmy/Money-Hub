{
  "manifest_version": 2,
  "name": "Money Hub - Capital One Sync",
  "version": "1.3.0",
  "description": "Syncs the visible Capital One balance to Money Hub.",
  "permissions": [
    "tabs",
    "https://*.capitalone.com/*",
    "https://jtczy6pfmy.github.io/Money-Hub/*"
  ],
  "background": {
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.capitalone.com/*"],
      "js": ["capital-one.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jtczy6pfmy.github.io/Money-Hub/*"],
      "js": ["money-hub-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "money-hub-capital-one-sync@jtczy6pfmy.github.io"
    }
  }
}