{
  "manifest_version": 3,
  "name": "Money Hub",
  "version": "1.0.0",
  "description": "Capture supported financial balances and send them to your Money Hub.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Money Hub",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["../shared/config.js", "../shared/detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
